<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <h1 class="h3 mb-3 fw-normal text-center">
    <%= t(".title") %>
  </h1>

  <%= render "devise/shared/error_messages", resource: resource %>

  <%= f.hidden_field :reset_password_token %>

  <div class="mb-3">
    <div class="form-floating position-relative"
         data-controller="password-visibility"
    >
      <%= f.password_field :password,
          autofocus: true,
          autocomplete: "new-password",
          class: "form-control",
          placeholder: t(".password"),
          data: { password_visibility_target: "input" } %>

      <%= f.label :password, t(".password") %>

      <%= render "devise/shared/password_toggle" %>
    </div>

    <small class="text-muted ms-1">
      <%= t("shared.password_hint", count: @minimum_password_length) %>
    </small>
  </div>

  <div class="form-floating mb-3 position-relative"
       data-controller="password-visibility"
  >
    <%= f.password_field :password_confirmation,
        autocomplete: "new-password",
        class: "form-control",
        placeholder: t(".password_confirmation"),
        data: { password_visibility_target: "input" } %>

    <%= f.label :password_confirmation, t(".password_confirmation") %>

    <%= render "devise/shared/password_toggle" %>
  </div>

  <div class="form-group">
    <%= f.submit t(".submit"), class: "btn btn-primary w-100 py-2" %>
  </div>

  <p class="text-center mt-3">
    <%= link_to t(".back_to_sign_in"), new_user_session_path, class: "text-muted small" %>
  </p>
<% end %>

<footer class="py-5 landing-footer">
  <div class="container">
    <div class="text-center footer-text mt-4">
      <%= link_to t("shared.footer.terms"), tos_path, class: "text-decoration-none me-3 footer-link" %>

      <span class="me-3">
        |
      </span>

      <%= link_to t("shared.footer.privacy"), privacy_policy_path, class: "text-decoration-none footer-link" %>
    </div>

    <div class="text-center footer-text mt-4">
      <small>
        <%= t("shared.footer.made_by_html") %>
      </small>
    </div>

    <div class="text-center footer-text mt-3">
      <small>
        <%= t("shared.footer.copyright", year: Time.now.year, app: Rails.application.class.module_parent_name) %>
      </small>
    </div>
  </div>
</footer>

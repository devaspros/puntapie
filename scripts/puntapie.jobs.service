# symlink to /home/ubuntu/.config/systemd/user/

[Unit]
Description=PUNTAPIE (jobs)
After=syslog.target network.target

[Service]
# bin/jobs en modo async corre workers, dispatcher y scheduler como hilos de
# un único proceso (sin fork). Por eso Type=simple.
#
# La prueba está en ejecutar el comando ExecStart desde la consola. Al hacerlo se queda "pegado".
#
# En esos caso se debe usar Type=simple para que systemd sepa que es un proceso que no forkea.
#
# Por ende se desactiva WatchDogSec=
#
# WatchdogSec=10

Type=simple

WorkingDirectory=/home/ubuntu/PUNTAPIE/app

# Greatly reduce Ruby memory fragmentation and heap usage
# https://www.mikeperham.com/2018/04/25/taming-rails-memory-bloat/
Environment=MALLOC_ARENA_MAX=2

# bin/jobs no acepta flag de entorno, solo lee RAILS_ENV
Environment=RAILS_ENV=production

EnvironmentFile=/home/ubuntu/.PUNTAPIE.envs
ExecStart=/home/ubuntu/.rubies/ruby-3.4.8/bin/bundle exec bin/jobs start --mode async

# if we crash, restart
RestartSec=1
Restart=on-failure

# output goes to /var/log/syslog
StandardOutput=syslog
StandardError=syslog

SyslogIdentifier=PUNTAPIE_jobs

[Install]
WantedBy=default.target

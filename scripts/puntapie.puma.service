[Unit]
Description=puntapie (puma)
After=network.target

[Service]
User=ubuntu

Type=simple

WorkingDirectory=/home/ubuntu/puntapie/app

# Igual que Jobs: memoria más estable en Ruby
Environment=MALLOC_ARENA_MAX=2

# Si tienes variables globales (DB, secrets, etc)
EnvironmentFile=/home/ubuntu/.puntapie.envs

ExecStart=/home/ubuntu/.local/bin/mise exec -- bundle exec puma -C config/puma.rb

ExecReload=/bin/kill -USR2 $MAINPID

Restart=on-failure
RestartSec=3

# Logs igual que Jobs (consistencia del VPS)
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=puntapie_puma

[Install]
WantedBy=multi-user.target
